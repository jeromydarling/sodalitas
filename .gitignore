node_modules
build
dist
dist-ssr
.react-router
.wrangler
worker-configuration.d.ts

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local env — secrets are Worker secrets, never files in the repo
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
*.local

# Nothing named like a credential store, anywhere in the tree. This repository
# is public, and a file of live secrets was committed to it once already — see
# SECURITY-ROTATION.md. These patterns are deliberately broad.
secrets/
*secrets*.env
*.pem
*.p12
*.key
!app/**/*.key

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?

# typescript build info
*.tsbuildinfo

# Generated marketing imagery IS committed.
#
# It used to be ignored, on the reasoning that `npm run images` could reproduce
# it from content/media.ts whenever wanted. That stopped being true the moment
# generation moved into CI: the runner produced all eight images, this rule
# swallowed them, and the job reported success with an empty commit. A green
# tick and no images is the worst of both.
#
# They're the Worker's static assets now — about 450KB of WebP in total, which
# is less than one npm dependency. The PNGs the generator emits stay ignored,
# since the workflow converts them and they never need to travel.
app/media/*.png
