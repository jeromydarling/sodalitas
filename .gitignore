# Nothing named like a credential store, anywhere in the tree. This repository
# is public, and a file of live secrets was committed to it once already — see
# SECURITY-ROTATION.md. These patterns are deliberately broad.
secrets/
*secrets*.env
*.pem
*.p12
*.key
!app/**/*.key

