{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sodalitas",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",

  // Smart Placement — run close to D1, not to the eyeball.
  "placement": { "mode": "smart" },

  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // ── Non-secret vars. Secrets are Worker secrets, set via `wrangler secret put`.
  // Every integration must degrade cleanly when its secret is absent.
  "vars": {
    "APP_URL": "https://sodalitas.jer-f84.workers.dev",
    "APP_ENV": "production",
    "MAIL_FROM": "hello@sodalitas.app",
    "MAIL_REPLY_TO": "hello@sodalitas.app"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sodalitas",
      "database_id": "67399404-a149-4afd-ac44-afc421ad9ae5",
      "migrations_dir": "db/migrations"
    }
  ],

  "kv_namespaces": [
    {
      // Sessions, magic-link tokens, rate-limit windows, feature flags,
      // cached dashboard rollups. Ephemeral by design.
      "binding": "KV",
      "id": "7d49d2691250486b98e813a0d4aaa977"
    }
  ],

  "r2_buckets": [
    {
      // Uploads, exports, generated PDFs, club page media.
      "binding": "R2",
      "bucket_name": "sodalitas-media"
    }
  ],

  // Cloudflare Email Service — outbound transactional mail, no secret required.
  //
  // Unrestricted on purpose: this binding mails members, guests and donors at
  // whatever address they gave their club, so neither `destination_address` nor
  // `allowed_destination_addresses` can be enumerated in advance. What it may
  // send *from* is pinned instead — the sender must belong to a domain onboarded
  // to Email Service, which is the check that actually matters.
  //
  // Local development simulates this: `wrangler dev` logs the message rather
  // than sending it, so sign-in links still work on a fresh checkout with no
  // account anywhere. Add "remote": true to send real mail from a local run —
  // real mail to real people, so use a test address.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@sodalitas.app"]
    }
  ],

  // The Images and Workers AI bindings are deliberately NOT declared here.
  //
  // Both proxy to Cloudflare even in local development, so declaring them makes
  // `npm run dev` require a CLOUDFLARE_API_TOKEN — which means a new
  // contributor cannot run the app at all until someone provisions them an
  // account. That trade is not worth it for two optional features.
  //
  // Anthropic over HTTPS is the default AI provider (see ai/provider.ts), and
  // it degrades to a friendly note when its key is absent. To enable Workers AI
  // as the cheap fallback tier, or on-the-fly image transforms, uncomment:
  //
  //   "ai": { "binding": "AI" },
  //   "images": { "binding": "IMAGES" },

  // Cron triggers. Times are UTC.
  //   05:00 daily  — club health snapshots (nightly, idempotent)
  //   06:15 Monday — weekly signal generation (after snapshots settle)
  //   */15         — outbound queue drain + webhook retries
  //   04:00 Sunday — demo tenant reset + housekeeping
  "triggers": {
    "crons": ["0 5 * * *", "15 6 * * 1", "*/15 * * * *", "0 4 * * 0"]
  }
}
